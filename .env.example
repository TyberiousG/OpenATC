# Copy to .env for local (non-Docker) runs. All values are optional.
# When DATABASE_URL is unset, the server runs fully in-memory.
DATABASE_URL=postgres://openatc:openatc@localhost:5432/openatc
PORT=8080
AIRPORT=KHOU
TRAFFIC_SEED=42
TRAFFIC_COUNT=6

# Deepgram API key enables server-side STT (keyword-biased) and TTS (Aura).
# Without it, the app falls back to the browser Web Speech API.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Frontend (Vite). Point the web client at the server's WebSocket.
VITE_WS_URL=ws://localhost:8080
